#!/bin/bash
# host-agent-admin: privileged helper used by the Home Assistant integration.
#
# Installed root:root 0755 in /usr/local/lib/host-agent/ by the bootstrap. The
# "host-agent-admin" SSH account may only run THIS script through sudo; every
# argument is validated here, files are only taken from the account's incoming
# directory and checked (sha256, version, configuration) before use.
#
# Commands:
#   status                      key=value report
#   install VERSION SHA256      install incoming/host-agent.pyz (+ incoming config), restart,
#                               roll back automatically when the service does not stay up
#   configure                   apply incoming/config.yaml (+ mqtt.secret), restart, roll back on failure
#   rollback                    re-activate the previous version
#   restart                     restart the agent service
#   reboot                      reboot the host (returns first, the reboot follows a few seconds later)
#   apt-update                  apt-get update (synchronous)
#   apt-upgrade                 start apt-get update + upgrade in the background (refused while a
#                               dirvish backup runs); returns first
#   apt-upgrade-status          key=value report of the last / current upgrade
#   apt-upgrade-log             tail of the upgrade log
#   read-config                 print /etc/host-agent/config.yaml (no secret)
#   uninstall [--purge]         stop and remove the agent (--purge: configuration and state too)
set -euo pipefail
umask 022
# shellcheck disable=SC2012  # version directory names are validated, ls is fine

# Overridable for tests only (sudo resets the environment in production)
ROOT="${HOST_AGENT_ROOT:-}"
SYSTEMCTL="${HOST_AGENT_SYSTEMCTL:-systemctl}"
PYTHON="${HOST_AGENT_PYTHON:-/usr/bin/python3}"
STABLE_WAIT="${HOST_AGENT_STABLE_WAIT:-8}"
APT_GET="${HOST_AGENT_APT_GET:-apt-get}"
PGREP="${HOST_AGENT_PGREP:-pgrep}"

PREFIX="${ROOT}/opt/host-agent"
CONF_DIR="${ROOT}/etc/host-agent"
STATE_DIR="${ROOT}/var/lib/host-agent"
ADMIN_HOME="${ROOT}/var/lib/host-agent-admin"
INCOMING="${ADMIN_HOME}/incoming"
UNIT="${ROOT}/etc/systemd/system/host-agent.service"
WRAPPER="${ROOT}/usr/local/bin/host-agent"
SERVICE=host-agent.service
KEEP_VERSIONS=3
LOCK="${ROOT}/run/host-agent-admin.lock"
UPGRADE_DIR="${ROOT}/var/lib/host-agent-upgrade"
UPGRADE_LOCK="${UPGRADE_DIR}/lock"
UPGRADE_STATE="${UPGRADE_DIR}/state"
UPGRADE_LOG="${UPGRADE_DIR}/upgrade.log"
SELF="$(readlink -f "$0")"

die() { echo "ERROR: $*" >&2; exit "${2:-1}"; }

command="${1:-}"
shift || true

take_lock() {
    mkdir -p "$(dirname "${LOCK}")"
    exec 9>"${LOCK}"
    # util-linux flock has a timeout option, BusyBox's does not
    if flock --help 2>&1 | grep -q -- "-w"; then
        flock -w 120 9 || die "another operation is running" 75
    else
        timeout 120 flock 9 || die "another operation is running" 75
    fi
}

# The package commands have their own lock: a long upgrade must never block the lifecycle
# commands (status, restart, reboot...) nor its own status
case "${command}" in
    apt-update|apt-upgrade|apt-upgrade-run|apt-upgrade-status|apt-upgrade-log) ;;
    *) take_lock ;;
esac

# Incoming files are written by the unprivileged admin account: refuse links and
# special files so root never follows a path chosen by that account.
check_incoming() {
    local f="$1"
    [[ -e "${f}" || -L "${f}" ]] || return 0
    [[ -f "${f}" && ! -L "${f}" ]] || die "refusing non regular file ${f}" 65
    [[ "$(stat -c %h "${f}")" == "1" ]] || die "refusing hard-linked file ${f}" 65
}

check_all_incoming() {
    [[ -d "${INCOMING}" && ! -L "${INCOMING}" ]] || die "missing incoming directory" 66
    local f
    for f in host-agent.pyz config.yaml mqtt.secret; do check_incoming "${INCOMING}/${f}"; done
}

group_exists() { getent group host-agent >/dev/null 2>&1; }

# Point "current" to a version: rename of a new link, atomic with GNU and BusyBox alike
switch_to() {
    ln -sfn "${PREFIX}/versions/$1" "${PREFIX}/current.new"
    if ! mv -Tf "${PREFIX}/current.new" "${PREFIX}/current" 2>/dev/null; then
        rm -f "${PREFIX}/current.new"
        ln -sfn "${PREFIX}/versions/$1" "${PREFIX}/current"
    fi
}

current_version() {
    local target
    target="$(readlink "${PREFIX}/current" 2>/dev/null || true)"
    if [[ -n "${target}" ]]; then basename "${target}"; fi
}

previous_version() { cat "${PREFIX}/previous" 2>/dev/null || true; }

service_restarts() { "${SYSTEMCTL}" show -p NRestarts --value "${SERVICE}" 2>/dev/null || echo 0; }

# Restart and make sure the service stays up for STABLE_WAIT seconds
restart_and_check() {
    "${SYSTEMCTL}" daemon-reload || true
    "${SYSTEMCTL}" enable "${SERVICE}" >/dev/null 2>&1 || true
    # never leak the lock descriptor to spawned processes
    "${SYSTEMCTL}" restart "${SERVICE}" 9>&- || return 1
    local before after
    before="$(service_restarts)"
    sleep "${STABLE_WAIT}"
    after="$(service_restarts)"
    "${SYSTEMCTL}" is-active --quiet "${SERVICE}" && [[ "${before}" == "${after}" ]]
}

journal_tail() { journalctl -u "${SERVICE}" -n 20 --no-pager 2>/dev/null >&2 || true; }

# Read-only access the collectors need: GPUs and Raspberry Pi firmware (video, render),
# the kernel log (systemd-journal, adm). Only groups that exist on this host.
ensure_groups() {
    # never touch the real accounts when testing against a fake root
    [[ -z "${ROOT}" ]] || return 0
    id -u host-agent >/dev/null 2>&1 || return 0
    local group
    for group in video render systemd-journal adm; do
        if getent group "${group}" >/dev/null 2>&1 && ! id -nG host-agent | tr ' ' '\n' | grep -qx "${group}"; then
            usermod -aG "${group}" host-agent || true
        fi
    done
}

write_wrapper() {
    mkdir -p "$(dirname "${WRAPPER}")"
    cat > "${WRAPPER}" <<EOF
#!/bin/sh
exec ${PYTHON} /opt/host-agent/current/host-agent.pyz --config "\${HOST_AGENT_CONFIG:-/etc/host-agent/config.yaml}" "\$@"
EOF
    chmod 0755 "${WRAPPER}"
}

# Validate incoming config (if any) with the given pyz; secret passed through env
validate_incoming_config() {
    local pyz="$1"
    [[ -f "${INCOMING}/config.yaml" ]] || return 0
    local secret=""
    [[ -f "${INCOMING}/mqtt.secret" ]] && secret="$(cat "${INCOMING}/mqtt.secret")"
    [[ -z "${secret}" && -f "${CONF_DIR}/mqtt.secret" ]] && secret="$(cat "${CONF_DIR}/mqtt.secret")"
    HOST_AGENT_MQTT_PASSWORD="${secret:-unset}" "${PYTHON}" "${pyz}" --config "${INCOMING}/config.yaml" validate >&2 \
        || die "invalid agent configuration" 65
}

# Install incoming config files, keeping a backup for rollback
apply_incoming_config() {
    mkdir -p "${CONF_DIR}"
    local owner_group="root"
    group_exists && owner_group="host-agent"
    chown "root:${owner_group}" "${CONF_DIR}" 2>/dev/null || true
    chmod 0750 "${CONF_DIR}"
    local f
    for f in config.yaml mqtt.secret; do
        if [[ -f "${INCOMING}/${f}" ]]; then
            [[ -f "${CONF_DIR}/${f}" ]] && cp -p "${CONF_DIR}/${f}" "${CONF_DIR}/${f}.bak"
            install -m 0640 -o root -g "${owner_group}" "${INCOMING}/${f}" "${CONF_DIR}/${f}"
            rm -f "${INCOMING}/${f}"
        fi
    done
}

restore_config_backup() {
    local f
    for f in config.yaml mqtt.secret; do
        [[ -f "${CONF_DIR}/${f}.bak" ]] && mv -f "${CONF_DIR}/${f}.bak" "${CONF_DIR}/${f}"
    done
    return 0
}

drop_config_backup() { rm -f "${CONF_DIR}/config.yaml.bak" "${CONF_DIR}/mqtt.secret.bak"; }

prune_versions() {
    local keep_current keep_previous
    keep_current="$(current_version)"
    keep_previous="$(previous_version)"
    # newest first, by modification time
    local count=0 dir name
    while IFS= read -r dir; do
        name="$(basename "${dir}")"
        count=$((count + 1))
        if (( count > KEEP_VERSIONS )) && [[ "${name}" != "${keep_current}" && "${name}" != "${keep_previous}" ]]; then
            rm -rf "${dir}"
        fi
    done < <(ls -1dt "${PREFIX}"/versions/*/ 2>/dev/null | sed 's#/$##')
}

cmd_status() {
    echo "version=$(current_version)"
    echo "previous=$(previous_version)"
    echo "versions=$(ls -1 "${PREFIX}/versions" 2>/dev/null | tr '\n' ' ' | sed 's/ $//')"
    echo "active=$("${SYSTEMCTL}" is-active "${SERVICE}" 2>/dev/null || true)"
    echo "enabled=$("${SYSTEMCTL}" is-enabled "${SERVICE}" 2>/dev/null || true)"
    echo "python=$("${PYTHON}" -c 'import sys; print("%d.%d.%d" % sys.version_info[:3])' 2>/dev/null || true)"
    echo "smartctl=$( (smartctl --version 2>/dev/null || /usr/sbin/smartctl --version 2>/dev/null) | awk 'NR==1{print $2}')"
    echo "config=$([[ -f "${CONF_DIR}/config.yaml" ]] && echo yes || echo no)"
}

cmd_install() {
    local version="${1:-}" sha="${2:-}"
    [[ "${version}" =~ ^[0-9]+\.[0-9]+\.[0-9]+([.+-]?[A-Za-z0-9.]+)?$ ]] || die "invalid version '${version}'" 64
    [[ "${sha}" =~ ^[0-9a-f]{64}$ ]] || die "invalid sha256" 64
    local src="${INCOMING}/host-agent.pyz"
    [[ -f "${src}" ]] || die "missing ${src}" 66
    [[ "$(sha256sum "${src}" | awk '{print $1}')" == "${sha}" ]] || die "checksum mismatch" 65

    local reported
    reported="$("${PYTHON}" "${src}" version 2>/dev/null | awk '{print $2}')"
    [[ "${reported}" == "${version}" ]] || die "archive reports version '${reported}', expected '${version}'" 65
    validate_incoming_config "${src}"

    local previous
    previous="$(current_version)"
    mkdir -p "${PREFIX}/versions/${version}"
    install -m 0644 -o root -g root "${src}" "${PREFIX}/versions/${version}/host-agent.pyz"
    rm -f "${src}"
    if [[ -n "${previous}" && "${previous}" != "${version}" ]]; then
        echo "${previous}" > "${PREFIX}/previous"
    fi
    switch_to "${version}"
    apply_incoming_config
    write_wrapper
    ensure_groups

    if restart_and_check; then
        drop_config_backup
        prune_versions
        echo "INSTALLED ${version}"
        return 0
    fi

    echo "Service failed with ${version}" >&2
    journal_tail
    restore_config_backup
    if [[ -n "${previous}" && "${previous}" != "${version}" && -d "${PREFIX}/versions/${previous}" ]]; then
        switch_to "${previous}"
        restart_and_check || true
        echo "ROLLED_BACK ${previous}"
    fi
    exit 3
}

cmd_configure() {
    [[ -f "${INCOMING}/config.yaml" || -f "${INCOMING}/mqtt.secret" ]] || die "nothing to configure" 66
    local version
    version="$(current_version)"
    [[ -n "${version}" ]] || die "agent not installed" 69
    validate_incoming_config "${PREFIX}/current/host-agent.pyz"
    apply_incoming_config
    if restart_and_check; then
        drop_config_backup
        echo "CONFIGURED"
        return 0
    fi
    journal_tail
    restore_config_backup
    restart_and_check || true
    echo "CONFIG_ROLLED_BACK"
    exit 3
}

cmd_rollback() {
    local previous current
    previous="$(previous_version)"
    current="$(current_version)"
    [[ -n "${previous}" && -d "${PREFIX}/versions/${previous}" ]] || die "no previous version" 69
    switch_to "${previous}"
    [[ -n "${current}" ]] && echo "${current}" > "${PREFIX}/previous"
    restart_and_check || { journal_tail; die "service failed after rollback" 3; }
    echo "ROLLED_BACK ${previous}"
}

cmd_restart() {
    restart_and_check || { journal_tail; die "service failed to restart" 3; }
    echo "RESTARTED"
}

# Detached and delayed so that this command (and the SSH session) ends cleanly before the
# host goes down; the lock descriptor is not leaked to the background shell
cmd_reboot() {
    ( sleep 3; "${SYSTEMCTL}" reboot ) </dev/null >/dev/null 2>&1 9>&- &
    echo "REBOOTING"
}

# --------------------------------------------------------------------------- #
# Package updates (apt only)
# --------------------------------------------------------------------------- #

# Unattended and conservative: configuration files already modified on the host are kept
# (the packaged version is written next to them as .dpkg-dist), no question is ever asked
apt_env() {
    env LC_ALL=C DEBIAN_FRONTEND=noninteractive NEEDRESTART_MODE=a NEEDRESTART_SUSPEND=1 "$@"
}

require_apt() { command -v "${APT_GET}" >/dev/null 2>&1 || die "apt is not available on this host" 69; }

# A dirvish backup must not be disturbed by a kernel module, ZFS or library upgrade
backup_running() { "${PGREP}" -f '(^|[ /])dirvish(-runall)?( |$)' >/dev/null 2>&1; }

# An upgrade holds this lock for its whole life: a dead worker is detected by the free lock
upgrade_lock_free() {
    mkdir -p "${UPGRADE_DIR}"
    exec 8>"${UPGRADE_LOCK}"
    if flock -n 8; then
        flock -u 8
        return 0
    fi
    return 1
}

write_upgrade_state() {
    # state started finished exit
    printf 'state=%s\nstarted=%s\nfinished=%s\nexit=%s\n' "$1" "$2" "$3" "$4" > "${UPGRADE_STATE}.new"
    mv -f "${UPGRADE_STATE}.new" "${UPGRADE_STATE}"
}

cmd_apt_update() {
    require_apt
    upgrade_lock_free || die "an update or upgrade is already running" 75
    exec 8>"${UPGRADE_LOCK}"
    flock -n 8 || die "an update or upgrade is already running" 75
    local rc=0
    apt_env "${APT_GET}" -q update >"${UPGRADE_DIR}/update.log" 2>&1 || rc=$?
    if (( rc != 0 )); then
        tail -n 5 "${UPGRADE_DIR}/update.log" >&2 || true
        die "apt-get update failed (exit ${rc})" 3
    fi
    echo "APT_UPDATED"
}

cmd_apt_upgrade() {
    require_apt
    backup_running && die "a dirvish backup is running, upgrade refused" 75
    upgrade_lock_free || die "an update or upgrade is already running" 75
    write_upgrade_state running "$(date +%s)" "" ""
    : > "${UPGRADE_LOG}"
    # Out of the SSH session: restarting sshd or systemd during the upgrade must not kill it
    if [[ -z "${ROOT}" ]] && command -v systemd-run >/dev/null 2>&1; then
        systemd-run --quiet --collect --unit=host-agent-upgrade "${SELF}" apt-upgrade-run \
            </dev/null >/dev/null 2>&1 9>&- || die "cannot start the upgrade" 3
    else
        setsid "${SELF}" apt-upgrade-run </dev/null >/dev/null 2>&1 9>&- &
    fi
    echo "UPGRADE_STARTED"
}

# Worker: runs detached, holds the upgrade lock until done
cmd_apt_upgrade_run() {
    mkdir -p "${UPGRADE_DIR}"
    exec 8>"${UPGRADE_LOCK}"
    flock -n 8 || exit 0
    local started rc=0
    started="$(sed -n 's/^started=//p' "${UPGRADE_STATE}" 2>/dev/null || true)"
    [[ -n "${started}" ]] || started="$(date +%s)"
    write_upgrade_state running "${started}" "" ""
    {
        echo "== apt-get update"
        apt_env "${APT_GET}" -q update || exit 1
        echo "== apt-get upgrade"
        apt_env "${APT_GET}" -q -y -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold \
            -o DPkg::Lock::Timeout=120 upgrade
    } >"${UPGRADE_LOG}" 2>&1 || rc=$?
    if (( rc == 0 )); then
        write_upgrade_state ok "${started}" "$(date +%s)" 0
    else
        write_upgrade_state failed "${started}" "$(date +%s)" "${rc}"
    fi
}

cmd_apt_upgrade_status() {
    if [[ ! -f "${UPGRADE_STATE}" ]]; then
        echo "state=idle"
        return 0
    fi
    local state
    state="$(sed -n 's/^state=//p' "${UPGRADE_STATE}")"
    local started
    started="$(sed -n 's/^started=//p' "${UPGRADE_STATE}")"
    # The worker is gone (host rebooted or killed) without writing its result; the grace
    # period covers the moment between the start request and the worker taking the lock
    if [[ "${state}" == "running" && "${started:-0}" =~ ^[0-9]+$ ]] \
        && (( $(date +%s) - started > 20 )) && upgrade_lock_free; then
        write_upgrade_state failed "${started}" "$(date +%s)" interrupted
    fi
    cat "${UPGRADE_STATE}"
}

cmd_apt_upgrade_log() {
    [[ -f "${UPGRADE_LOG}" ]] || return 0
    tail -n 40 "${UPGRADE_LOG}"
}

cmd_read_config() {
    [[ -f "${CONF_DIR}/config.yaml" ]] || die "no configuration" 66
    cat "${CONF_DIR}/config.yaml"
}

cmd_uninstall() {
    local purge="${1:-}"
    "${SYSTEMCTL}" disable --now "${SERVICE}" >/dev/null 2>&1 || true
    rm -f "${UNIT}" "${WRAPPER}"
    "${SYSTEMCTL}" daemon-reload >/dev/null 2>&1 || true
    rm -rf "${PREFIX}"
    if [[ "${purge}" == "--purge" ]]; then
        rm -rf "${CONF_DIR}" "${STATE_DIR}" "${UPGRADE_DIR}"
        # Revoke Home Assistant's access last
        rm -f "${ROOT}/etc/sudoers.d/host-agent-admin" "${ADMIN_HOME}/.ssh/authorized_keys"
    fi
    echo "UNINSTALLED"
}

case "${command}" in
    install|configure) check_all_incoming ;;
esac
case "${command}" in
    status) cmd_status ;;
    install) cmd_install "$@" ;;
    configure) cmd_configure ;;
    rollback) cmd_rollback ;;
    restart) cmd_restart ;;
    reboot) cmd_reboot ;;
    apt-update) cmd_apt_update ;;
    apt-upgrade) cmd_apt_upgrade ;;
    apt-upgrade-run) cmd_apt_upgrade_run ;;
    apt-upgrade-status) cmd_apt_upgrade_status ;;
    apt-upgrade-log) cmd_apt_upgrade_log ;;
    read-config) cmd_read_config ;;
    uninstall) cmd_uninstall "$@" ;;
    *) die "usage: host-agent-admin status|install VERSION SHA256|configure|rollback|restart|reboot|apt-update|apt-upgrade|apt-upgrade-status|apt-upgrade-log|read-config|uninstall [--purge]" 64 ;;
esac
