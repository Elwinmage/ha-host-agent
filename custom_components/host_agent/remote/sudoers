Defaults:host-agent-admin !requiretty
Defaults:host-agent-admin env_reset
host-agent-admin ALL=(root) NOPASSWD: /usr/local/lib/host-agent/host-agent-admin, /usr/local/lib/host-agent/host-agent-admin *
